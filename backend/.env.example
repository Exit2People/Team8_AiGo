# 이 파일을 .env 로 복사해서 써요. .env 는 저장소에 올리지 않아요.

# Claude API 키. 비워 두면 AI 없이 기본 질문 · 규칙 기반 추천으로 동작해요.
ANTHROPIC_API_KEY=
AIGO_MODEL=claude-sonnet-5-5
# 1 이면 추천을 LangGraph 에이전트가 골라요 (도구 사용 · 다녀온 곳 메모리). 8초보다 오래 걸려요.
AIGO_AGENT=

# TypeSafe Jev 키 (console.typesafe.ai). AIGO_JEV=1 이면 AI가 쓴 추천 이유를 Jev가 한 번 더 확인해요.
# 비워 두거나 Jev가 늦으면 기존 확인(verify_picks)만 써요.
TYPESAFE_API_KEY=
AIGO_JEV=
# 톡방 글 검사: 키가 있으면 Jev가 욕설 · 성희롱 · 불법 권유 · 정치 비방/선동 글을 막아요(금지어 목록은 키 없이도 늘 동작).
# 0 이면 Jev 검사를 끄고 금지어 목록만 써요. 글은 저장하지 않지만 외부(TypeSafe)로 보내지니 개인정보 처리방침에 적어요.
AIGO_CHAT_JEV=

# 시연용 덮어쓰기 (비워 두면 실제 값)
# 지금 시각: "14:10" 또는 "2026-11-21T14:10"
AIGO_NOW=
# 날씨: 맑음 / 비 / 눈
AIGO_WEATHER=

# 프론트엔드가 부를 서버 주소 (frontend/.env.local 에 넣어요)
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# 질문 5 방식: graph(후보 기반) / single(이전 방식)
AIGO_QUESTION=graph

# 외부 API
DATA_GO_KR_SERVICE_KEY=
SEOUL_OPENAPI_KEY=
KAKAO_REST_API_KEY=
# 카카오 로그인 Client Secret (콘솔 > 앱 > 플랫폼 키 > REST API 키)
KAKAO_CLIENT_SECRET=
# 탈퇴 때 카카오 '연결 끊기'용 어드민 키 (콘솔 > 앱 > 어드민 키, 서버에만). 없으면 연결 끊기를 건너뛰어요
KAKAO_ADMIN_KEY=
KAKAO_JS_KEY=
TMAP_APP_KEY=
